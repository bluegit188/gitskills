double DailyRTH::getAEMAOO(int loc)
{
    if(loc<43)
    {
       cerr<<"Warning: less than 42 days to compute AEMAOO"<<endl;
       exit(1);
    }

    vector<double> OOs;
    for(unsigned int i=0;i<42;i++)
    {
        double x=getOOP1D(loc-i);
	if(x==NA_DBL )
        {
	    cerr<<"Error: One of the OOs is NA"<<endl;
	    exit(1);
	}
        OOs.push_back(x);
    }

    //double ABSOO3=abs(OOs[2]);
    double a=0.75;
    double emaOO=0;
    for(unsigned int i=2;i<OOs.size();i++)
    {
        double x=OOs[i];
	emaOO+=x*pow(a,i-2.0);
    }
    emaOO*=(1-a);
    emaOO=0.89*emaOO+0.11*OOs[1];
    double AEMAOO=abs(emaOO);
    AEMAOO=constrain(AEMAOO,0,1.2);

    return AEMAOO;
}





