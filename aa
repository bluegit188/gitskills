double DailyRTH::getOO7t20(int loc)
{
    if(loc<20)
    {
       cerr<<"Warning: less than 21 days to compute OO7t20"<<endl;
       exit(1);
    }


    vector<double> OOs;
    for(unsigned int i=0;i<42;i++)
    {
        double x=getOOP1D(loc-i);
	if(x==NA_DBL )
        {
	    cerr<<"Error: One of the OOs is NA"<<endl;
	    exit(1);
	}
        OOs.push_back(x);
    }

    double OO7t20=vectorSubsetSum(OOs,6,19);
    OO7t20=constrain(OO7t20,-12.0,12.0);

    return OO7t20;
}



