double  DailyRTH::getCCP1DNoLag(int loc, double LB, double UB)
{
    if(loc< 1)
    {
      return NA_DBL;
    }
    DailyRTHUnit du0=myStorage[loc]; 
    DailyRTHUnit du1=myStorage[loc-1];

    double FVOO=du0.FVOO;
    double CCP1D=(du0.close-du0.cumSpd)-(du1.close-du1.cumSpd);
    CCP1D/=FVOO;    
    return constrain(CCP1D,LB,UB);
}

